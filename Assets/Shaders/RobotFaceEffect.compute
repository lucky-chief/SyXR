// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel ColorCloudTunnels
#pragma kernel SiriLike
#pragma kernel Loading
#pragma kernel Snowy
#pragma kernel GridLoading
#pragma kernel Portal

// Create a RenderTexture with enableRandomWrite flag and set it
// with cs.SetTexture
RWTexture2D<float4> Result;
float _Time, _FloatParam0, _FloatParam1;
float2 _iResolution;

#define P(z) float3(cos(float2(.15,.2)*(z))*5.,z)
//彩色虫洞
[numthreads(32,32,1)]
void ColorCloudTunnels (uint3 id : SV_DispatchThreadID)
{
    float4 o = 0.0;
    float2 iResolution = float2(128., 128.);
    float i = 0.,d = 0.,s = 0.,n = 0.,t=_Time*3.;
    float3  q = iResolution.xyy,
            p = P(t),
            Z = normalize( P(t+1.)- p),
            X = normalize(float3(Z.z,0.,-Z.x)),
            D = mul(transpose(float3x3(-X, cross(X, Z), Z)), float3((id.xy-q.xy/2.)/q.y, 1));
    for(o*=i; i++<1e2;) {
        p += D * s;
        q = P(p.z)+cos(t+p.yzx)*.3;
        s  = 2.  - min(length((p-q).xy),
                   min(length(p.xy - q.y) ,
                       length(p.xy - q.x)));
        for (n = .1; n < 1.;
            s -= abs(dot(sin(p * n * 16.), q-q+.03)) / n,
            n += n);
        d += s = .04 + abs(s)*.2;
        o += (1.+cos(d+float4(4,2,1,0))) / s / d;
    }
    o = tanh(o / 2e2);

    Result[id.xy] = o;
}

[numthreads(32,32,1)]
void SiriLike(uint3 id : SV_DispatchThreadID)
{
    float4 O = 0.0;
    float2 iResolution = float2(128., 128.);
    float t = _Time * 1.5, i = 0.0, d = 0.0, z = 0.0, s = 0.0;
    [unroll(100)]
    for(O *= i; i++ < 1e2;)
    {
        //Raymarch sample point
        float3 p = z * normalize(float3(2.0 * id.xy,0) - iResolution.xyy),
        //floattor for undistorted coordinates
        v;
        //Shift camera back 9 units
        p.z += 9.;
        //Save coordinates
        v = p;
        //Apply turbulence waves
        //https://mini.gmshaders.com/p/turbulence
        [unroll(4)]
        for (d = 1.; d < 9.; d += d)
            p += .5 * sin(p.yzx * d + t) / d;
        //Distance to gyroid
        z += d = .2 * (.01 + abs(s = dot(cos(p), sin(p / .7).yzx))
        //Spherical boundary
        - min(d = 6. - length(v), -d * .1));
        //Coloring and glow attenuation
        O += (cos(s / .1 + z + t + float4(2, 4, 5, 0)) + 1.2) / d / z;
    }
    //Tanh tonemapping
    //https://www.shadertoy.com/view/ms3BD7
    O = tanh(O / 2e3);

    Result[id.xy] = O;
}

/////////////////////////////////////////////////////////////////////////////////////////////////
//https://iquilezles.org/articles/palettes/
float3 palette( float t ) {
    float3 a = float3(0.5, 0.5, 0.5);
    float3 b = float3(0.5, 0.5, 0.5);
    float3 c = float3(1.0, 1.0, 1.0);
    float3 d = float3(0.263,0.416,0.557);

    return a + b*cos( 6.28318*(c*t+d) );
}

[numthreads(32,32,1)]
void Loading(uint3 id : SV_DispatchThreadID)
{
    float2 iResolution = 128.;
    float2 uv = (id.xy * 2.0 - iResolution.xy) / iResolution.y;
    // float2 uv = id.xy / iResolution;
    uv *= 1.5;
    float2 uv0 = uv;
    float3 finalColor = 0.0;
    
    for (float i = 0.0; i < 4.0; i++) {
        uv = frac(uv * 1.5) - 0.5;

        float d = length(uv) * exp(-length(uv0));

        float3 col = palette(length(uv0) + i*.4 + _Time*.4);

        d = sin(d*8. + _Time)/8.;
        d = abs(d);

        d = pow(0.01 / d, 1.2);

        finalColor += col * d;
    }
        
    Result[id.xy] = float4(finalColor, 1.0);
}
////////////////////////////////////////////////////////////////////////////////////////////
float2 mod289(float2 x) {
    return x - floor(x * (1.0 / 289.0)) * 289.0;
}

float3 mod289(float3 x) {
    return x - floor(x * (1.0 / 289.0)) * 289.0;
}

float4 mod289(float4 x) {
    return x - floor(x * (1.0 / 289.0)) * 289.0;
}

float3 permute(float3 x) {
    return mod289(((x*34.0)+1.0)*x);
}

float4 permute(float4 x) {
    return ((34.0 * x + 1.0) * x) % 289.0;
}

float4 taylorInvSqrt(float4 r)
{
    return 1.79284291400159 - 0.85373472095314 * r;
}

float snoise(float2 v)
{
        const float4 C = float4(0.211324865405187,0.366025403784439,-0.577350269189626,0.024390243902439);
        float2 i  = floor(v + dot(v, C.yy) );
        float2 x0 = v -   i + dot(i, C.xx);
        
        float2 i1;
        i1 = (x0.x > x0.y) ? float2(1.0, 0.0) : float2(0.0, 1.0);
        float4 x12 = x0.xyxy + C.xxzz;
        x12.xy -= i1;
        
        i = mod289(i); // Avoid truncation effects in permutation
        float3 p = permute( permute( i.y + float3(0.0, i1.y, 1.0 ))
            + i.x + float3(0.0, i1.x, 1.0 ));
        
        float3 m = max(0.5 - float3(dot(x0,x0), dot(x12.xy,x12.xy), dot(x12.zw,x12.zw)), 0.0);
        m = m*m ;
        m = m*m ;
        
        float3 x = 2.0 * frac(p * C.www) - 1.0;
        float3 h = abs(x) - 0.5;
        float3 ox = floor(x + 0.5);
        float3 a0 = x - ox;
        
        m *= 1.79284291400159 - 0.85373472095314 * ( a0*a0 + h*h );
        
        float3 g;
        g.x  = a0.x  * x0.x  + h.x  * x0.y;
        g.yz = a0.yz * x12.xz + h.yz * x12.yw;

        return 130.0 * dot(m, g);		
}

float cellular2x2(float2 P)
{
        #define K 0.142857142857 // 1/7
        #define K2 0.0714285714285 // K/2
        #define jitter 0.8 // jitter 1.0 makes F1 wrong more often
        
        float2 Pi = floor(P)%289.0;
        float2 Pf = frac(P);
        float4 Pfx = Pf.x + float4(-0.5, -1.5, -0.5, -1.5);
        float4 Pfy = Pf.y + float4(-0.5, -0.5, -1.5, -1.5);
        float4 p = permute(Pi.x + float4(0.0, 1.0, 0.0, 1.0));
        p = permute(p + Pi.y + float4(0.0, 0.0, 1.0, 1.0));
        float4 ox = (p % 7.0)*K+K2;
        float4 oy = (floor(p*K) % 7.0)*K+K2;
        float4 dx = Pfx + jitter*ox;
        float4 dy = Pfy + jitter*oy;
        float4 d = dx * dx + dy * dy; // d11, d12, d21 and d22, squared
        // Sort out the two smallest distances
        
        // Cheat and pick only F1
        d.xy = min(d.xy, d.zw);
        d.x = min(d.x, d.y);
        return d.x; // F1 duplicated, F2 not computed
}

float fbm(float2 p) {
    float f = 0.0;
    float w = 0.5;
    for (int i = 0; i < 5; i ++) {
        f += w * snoise(p);
        p *= 2.;
        w *= 0.5;
    }
    return f;
}

[numthreads(32,32,1)]
void Snowy(uint3 id : SV_DispatchThreadID)
{
    float4 fragColor = 0.0;
    float speed=0.4;
    float2 iResolution = 128.;
    float2 uv = id.xy / iResolution.xy;
    
    uv.x*=(iResolution.x/iResolution.y);
    
    float2 suncent=float2(0.3,0.8);
    
    float suns=(1.0-distance(uv,suncent));
    suns=clamp(0.2+suns,0.0,1.0);
    float sunsh=smoothstep(0.94,0.999,suns);

    float slope;
    slope=0.8+uv.x-(uv.y*2.3);
    slope=1.0-smoothstep(0.55,0.0,slope);								
    
    float noise=abs(fbm(uv*1.5));
    slope=(noise*0.2)+(slope-((1.0-noise)*slope*0.1))*0.6;
    slope=clamp(slope,0.0,1.0);
                            
    float2 GA = 0.;
    GA.x-=_Time*0.3;
    GA.y+=_Time*0.9;
    GA*=speed;

    float F1=0.0,F2=0.0,F3=0.0,F4=0.0,F5=0.0,N1=0.0,N2=0.0,N3=0.0,N4=0.0,N5=0.0;
    float A=0.0,A1=0.0,A2=0.0,A3=0.0,A4=0.0,A5=0.0;


    // Attentuation
    A = (uv.x-(uv.y*0.3));
    A = clamp(A,0.0,1.0);

    // Snow layers, somewhat like an fbm with worley layers.
    F1 = 1.0-cellular2x2((uv+(GA*0.1))*8.0);	
    A1 = 1.0-(A*1.0);
    N1 = smoothstep(0.998,1.0,F1)*1.0*A1;	

    F2 = 1.0-cellular2x2((uv+(GA*0.2))*6.0);	
    A2 = 1.0-(A*0.8);
    N2 = smoothstep(0.995,1.0,F2)*0.85*A2;				

    F3 = 1.0-cellular2x2((uv+(GA*0.4))*4.0);	
    A3 = 1.0-(A*0.6);
    N3 = smoothstep(0.99,1.0,F3)*0.65*A3;				

    F4 = 1.0-cellular2x2((uv+(GA*0.6))*3.0);	
    A4 = 1.0-(A*1.0);
    N4 = smoothstep(0.98,1.0,F4)*0.4*A4;				

    F5 = 1.0-cellular2x2((uv+(GA))*1.2);	
    A5 = 1.0-(A*1.0);
    N5 = smoothstep(0.98,1.0,F5)*0.25*A5;				
                    
    float Snowout=N5+N4+N3+N2+N1;
                    
    //Snowout = 0.35+(slope*(suns+0.3))+(sunsh*0.6)+N1+N2+N3+N4+N5;
    Snowout = 0.35 + (slope *  0.3) + N1 + N2 + N3 + N4 + N5;
    
    fragColor = float4(Snowout * 0.9, Snowout, Snowout * 1.1, Snowout);
    Result[id.xy] = fragColor;
}
////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////
[numthreads(32,32,1)]
void GridLoading(uint3 id : SV_DispatchThreadID)
{
    float2 iResolution = 128.;
    float2  px = 4.0*(-iResolution.xy + 2.0*id.xy) / iResolution.y;
    float ids = 0.5 + 0.5*cos(_Time + sin(dot(floor(px+0.5),float2(113.1,17.81)))*43758.545);
    float3  co = 0.5 + 0.5*cos(_Time + 2.0*ids + float3(0.0,1.0,2.0) );
    float2  pa = smoothstep( 0.0, 0.2, ids*(0.5 + 0.5*cos(6.2831*px)) );
    Result[id.xy] = float4( co*pa.x*pa.y, 1.0 );
}
////////////////////////////////////////////////////////////////////////////////////////////

// Ref - https://x.com/cmzw_/status/1787147460772864188 (celestianmaze)

float4 permute_3d(float4 x) { return fmod(((x * 34.0) + 1.0) * x, 289.0); }
float4 taylorInvSqrt3d(float4 r) { return 1.79284291400159 - 0.85373472095314 * r; }

float simplexNoise3d(float3 v) {
    const float2 C = float2(1.0/6.0, 1.0/3.0);
    const float4 D = float4(0.0, 0.5, 1.0, 2.0);

    // First corner
    float3 i = floor(v + dot(v, C.yyy));
    float3 x0 = v - i + dot(i, C.xxx);

    // Other corners
    float3 g = step(x0.yzx, x0.xyz);
    float3 l = 1.0 - g;
    float3 i1 = min(g.xyz, l.zxy);
    float3 i2 = max(g.xyz, l.zxy);

    float3 x1 = x0 - i1 + C.xxx;
    float3 x2 = x0 - i2 + 2.0 * C.xxx;
    float3 x3 = x0 - 1.0 + 3.0 * C.xxx;

    // Permutations
    i = fmod(i, 289.0);
    float4 p = permute_3d(permute_3d(permute_3d(i.z + float4(0.0, i1.z, i2.z, 1.0)) + i.y + float4(0.0, i1.y, i2.y, 1.0)) + i.x + float4(0.0, i1.x, i2.x, 1.0));

    // Gradients
    float n_ = 1.0/7.0; // N=7
    float3 ns = n_ * D.wyz - D.xzx;

    float4 j = p - 49.0 * floor(p * ns.z * ns.z);

    float4 x_ = floor(j * ns.z);
    float4 y_ = floor(j - 7.0 * x_);

    float4 x = x_ * ns.x + ns.yyyy;
    float4 y = y_ * ns.x + ns.yyyy;
    float4 h = 1.0 - abs(x) - abs(y);

    float4 b0 = float4(x.xy, y.xy);
    float4 b1 = float4(x.zw, y.zw);

    float4 s0 = floor(b0) * 2.0 + 1.0;
    float4 s1 = floor(b1) * 2.0 + 1.0;
    float4 sh = -step(h, float4(0.0, 0.0, 0.0, 0.0));

    float4 a0 = float4(b0.xzyw + s0.xzyw * sh.xxyy);
    float4 a1 = float4(b1.xzyw + s1.xzyw * sh.zzww);

    float3 p0 = float3(a0.xy, h.x);
    float3 p1 = float3(a0.zw, h.y);
    float3 p2 = float3(a1.xy, h.z);
    float3 p3 = float3(a1.zw, h.w);

    // Normalise gradients
    float4 norm = taylorInvSqrt3d(float4(dot(p0, p0), dot(p1, p1), dot(p2, p2), dot(p3, p3)));
    p0 *= norm.x;
    p1 *= norm.y;
    p2 *= norm.z;
    p3 *= norm.w;

    // Mix final noise value
    float4 m = max(0.6 - float4(dot(x0, x0), dot(x1, x1), dot(x2, x2), dot(x3, x3)), 0.0);
    m = m * m;
    return 42.0 * dot(m * m, float4(dot(p0, x0), dot(p1, x1), dot(p2, x2), dot(p3, x3)));
}

float fbm3d(float3 x, const int it) {
    float v = 0.0;
    float a = 0.5;
    float3 shift = float3(100, 100, 100);
    
    for (int i = 0; i < 32; ++i) {
        if(i < it) {
            v += a * simplexNoise3d(x);
            x = x * 2.0 + shift;
            a *= 0.5;
        }
    }
    return v;
}

float3 rotateZ(float3 v, float angle) {
    float cosAngle = cos(angle);
    float sinAngle = sin(angle);
    return float3(
        v.x * cosAngle - v.y * sinAngle,
        v.x * sinAngle + v.y * cosAngle,
        v.z
    );
}

float facture(float3 v) {
    float3 normalizedVector = normalize(v);
    return max(max(normalizedVector.x, normalizedVector.y), normalizedVector.z);
}

float3 emission(float3 color, float strength) {
    return color * strength;
}

[numthreads(32,32,1)]
void Portal(uint3 id : SV_DispatchThreadID)
{
    float2 iResolution = _iResolution;
    float2 fragCoord = id.xy;
    float iTime = _Time;
// Normalized pixel coordinates
    float2 uv = (fragCoord * 2.0 - iResolution.xy) / iResolution.y;
    
    float3 color = float3(uv.xy, 0.0);
    color.z += 0.5;
    color = normalize(color);
    color -= 0.2 * float3(0.0, 0.0, iTime);
    
    float angle = -log2(length(uv));
    color = rotateZ(color, angle);
    
    float frequency = 1.4;
    float distortion = 0.01;
    color.x = fbm3d(color * frequency + 0.0, 5) + distortion;
    color.y = fbm3d(color * frequency + 1.0, 5) + distortion;
    color.z = fbm3d(color * frequency + 2.0, 5) + distortion;
    float3 noiseColor = color; // save
    
    noiseColor *= 2.0;
    noiseColor -= 0.1;
    noiseColor *= 0.188;
    noiseColor += float3(uv.xy, 0.0);
    
    float noiseColorLength = length(noiseColor);
    noiseColorLength = 0.770 - noiseColorLength;
    noiseColorLength *= 4.2;
    noiseColorLength = pow(noiseColorLength, 1.0);
    
    float3 emissionColor = emission(float3(0.2, 0.6, 0.9), noiseColorLength * _FloatParam0);
    
    float fac = length(uv) - facture(color + 0.32);
    fac += 0.1;
    fac *= 3.0;
    
    color = lerp(emissionColor, float3(0.2, 0.6, 1.0), fac + 0.3);
    
    float gray = color.r * 0.125 + color.b * 0.236 + color.g * 0.639;
    float c = smoothstep(1.0, 1.0 - 0.2, gray);
    color *= c;
    Result[id.xy] = float4( color, gray );
    // Result[id.xy] = float4( 1.0, 0.0, 0.0, color.r );
}